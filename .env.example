# Copy to `.env` at the repo root (do not commit secrets).
# Shared by backend + frontend.

# --- Ports (Hostinger: avoid link-me 3020/3021/4000 and other stacks) ---
PORT=5002
API_HOST_PORT=5030
FRONTEND_HOST_PORT=3030
POSTGRES_PORT=5434

# --- Docker network (link-me style) ---
# Next.js server proxies same-origin /api → Express on the compose network.
API_URL=http://api:5002
# Browser calls same-origin /api (no CORS). Do not set this to http://IP:5030/api in Docker.
NEXT_PUBLIC_API_URL=/api

# Browser → sockets must reach the published API host port (replace YOUR_PUBLIC_IP).
NEXT_PUBLIC_SOCKET_URL=http://YOUR_PUBLIC_IP:5030
# Comma-separated if needed. Used for CORS / auth email links.
FRONTEND_URL=http://YOUR_PUBLIC_IP:3030
CORS_ORIGIN=*

# Local `pnpm/npm dev` (no Docker) alternative:
#   API_URL=http://localhost:5002
#   NEXT_PUBLIC_API_URL=http://localhost:5002/api
#   NEXT_PUBLIC_SOCKET_URL=http://localhost:5002
#   FRONTEND_URL=http://localhost:3000

# --- PostgreSQL ---
# Compose overrides NEON_DB_URI inside api/frontend to @postgres:5432.
POSTGRES_USER=creatorhub
POSTGRES_PASSWORD=changeme
POSTGRES_DB=creatorhub
NEON_DB_URI=postgresql://creatorhub:changeme@localhost:5434/creatorhub
DATABASE_URL=postgresql://creatorhub:changeme@localhost:5434/creatorhub

# --- Auth / security ---
# Must pass backend/utils/authSecurity.js (>=32 bytes). Use: openssl rand -hex 32
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Optional. If set, MUST be: cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# --- Captcha (Cloudflare Turnstile) — leave unset to disable ---
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- SMTP ---
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM="Your Name <your_email@example.com>"
SMTP_FROM="Your Name <your_email@example.com>"
