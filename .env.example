# Copy to `.env` at the repo root (do not commit secrets).
# Shared by backend + frontend. Package-level `.env` files still work as overrides.

# --- App ports ---
# Inside Docker the API listens on PORT; the host publishes API_HOST_PORT.
PORT=5002
API_HOST_PORT=5030
FRONTEND_HOST_PORT=3030

# Browser-facing URLs must use HOST ports when using Docker Compose.
# Local `pnpm/npm dev` (no Docker): use http://localhost:3000 and :5002 instead.
FRONTEND_URL=http://localhost:3030
NEXT_PUBLIC_API_URL=http://localhost:5030/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5030

# --- PostgreSQL ---
# Docker Compose overrides NEON_DB_URI inside containers to the postgres service.
# Host-run apps should use published port 5434.
POSTGRES_USER=creatorhub
POSTGRES_PASSWORD=changeme
POSTGRES_DB=creatorhub
POSTGRES_PORT=5434
NEON_DB_URI=postgresql://creatorhub:changeme@localhost:5434/creatorhub
DATABASE_URL=postgresql://creatorhub:changeme@localhost:5434/creatorhub

# --- Auth / security ---
# Must pass backend/utils/authSecurity.js (>=32 bytes, entropy, unique chars).
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Optional. If set, MUST be: cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# --- Captcha (Cloudflare Turnstile) — leave unset / commented to disable captcha ---
# TURNSTILE_SITE_KEY=your_real_site_key
# TURNSTILE_SECRET_KEY=your_real_secret_key
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_real_site_key

# --- SMTP ---
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM="Your Name <your_email@example.com>"
SMTP_FROM="Your Name <your_email@example.com>"

# Optional: legacy Mongo scripts only (migrate:subscriptions backfill)
# MONGODB_URI=mongodb://localhost:27020/creatorhub
