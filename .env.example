# Copy to `.env` at the repo root (do not commit secrets).
# Shared by backend + frontend. Package-level `.env` files still work as overrides.

# --- App ports (local defaults; Docker publishes different host ports — see below) ---
PORT=5002
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5002/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5002

# --- PostgreSQL ---
# Local / Neon (non-Docker): set your connection string here.
# Docker Compose overrides NEON_DB_URI for the api/frontend containers to the
# internal postgres service. Host-run apps (pnpm/npm dev) should use the
# published host port below (5434) so they do not collide with other stacks.
POSTGRES_USER=creatorhub
POSTGRES_PASSWORD=changeme
POSTGRES_DB=creatorhub
# Host publish: 5434 (link-me uses internal 5432; avoid host 5432 conflicts)
POSTGRES_PORT=5434
NEON_DB_URI=postgresql://creatorhub:changeme@localhost:5434/creatorhub
# Alias used by some modules
DATABASE_URL=postgresql://creatorhub:changeme@localhost:5434/creatorhub

# --- Docker published app ports (Hostinger — avoid clashes with other projects) ---
# Taken on host: 3000-3002, 3010, 3020-3021, 4000, 5000, 5020, 8000
# CreatorHub uses: frontend 3030, api 5030, postgres 5434
API_HOST_PORT=5030
FRONTEND_HOST_PORT=3030

# --- Auth / security ---
# Must pass backend/utils/authSecurity.js (>=32 bytes, entropy, unique chars).
# Dev-only example — use a unique value in production (e.g. openssl rand -hex 32).
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=your_cloudinary_url

# --- Captcha (Cloudflare Turnstile) ---
TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key

# --- SMTP ---
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM="Your Name <your_email@example.com>"
SMTP_FROM="Your Name <your_email@example.com>"

# Optional: legacy Mongo scripts only (migrate:subscriptions backfill)
# MONGODB_URI=mongodb://localhost:27020/creatorhub
